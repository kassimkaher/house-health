# Copy to .env.production or .env.staging and fill in real values.
# NEVER commit a filled-in copy of this file — .gitignore already excludes
# .env.* except this template.

# --- Public domains -----------------------------------------------------
# Used both for Nginx server_name matching and app CORS/callback URLs.
# These match the literal server_name values baked into
# infrastructure/nginx/conf.d/*.conf — if you deploy to different domains,
# update both this file and those nginx configs (they are static, not
# templated).
API_PUBLIC_URL=https://api-health-house.aljoodnet.info
ADMIN_WEB_PUBLIC_URL=https://health-house.aljoodnet.info
# Must be reachable from the public internet — presigned upload/download
# URLs are signed against this host (see infrastructure/nginx/conf.d/s3.conf).
S3_PUBLIC_URL=https://s3-health-house.aljoodnet.info
# Comma-separated list of any ADDITIONAL allowed CORS origins (mobile app
# custom schemes, etc). ADMIN_WEB_PUBLIC_URL is always allowed; leave blank
# if nothing else needs it.
CORS_ORIGINS=

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=hh_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
POSTGRES_DB=health_house

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=hh_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
S3_BUCKET_PREFIX=hh-prod

# --- Auth -------------------------------------------------------------------
# Generate with: openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
# then derive the public key with: openssl ec -in <private.pem> -pubout
# Paste each PEM as a DOUBLE-QUOTED, real-multi-line value (Docker Compose's
# env-file parser preserves the embedded newlines — confirmed via
# `docker compose config`). Do NOT flatten to literal "\n": the `jose`
# library used for JWT signing fails to parse that form (ASN.1 error), so a
# flattened key looks fine here but breaks the app at token-signing time.
# Prefer Docker secrets / a secrets manager in production instead of plain env.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
ACCESS_TOKEN_TTL_SEC=600
REFRESH_TOKEN_TTL_DAYS=30

# Optional — leave all three blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-health-house.aljoodnet.info/api/v1/auth/google/callback

# --- Observability (optional) ------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_TRACKING_DSN=

# --- Build/deploy -------------------------------------------------------------
# Tag applied to built images; bump per release for easy rollback
# (`docker compose ... up -d` with a prior IMAGE_TAG re-deploys that build).
IMAGE_TAG=latest
NODE_ENV=production
