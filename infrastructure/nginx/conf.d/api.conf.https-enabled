# Installed over api.conf by scripts/enable-tls.sh once a certificate
# exists at the paths below. Do not edit conf.d/api.conf directly for TLS
# changes — edit this file so re-running enable-tls.sh stays idempotent.

server {
    listen 80;
    listen [::]:80;
    server_name api-health-house.aljoodnet.info;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api-health-house.aljoodnet.info;

    ssl_certificate     /etc/letsencrypt/live/api-health-house.aljoodnet.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-health-house.aljoodnet.info/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    location = /metrics {
        allow 172.16.0.0/12;
        allow 10.0.0.0/8;
        deny all;
        proxy_pass http://api:3100/metrics;
    }

    location /health/ {
        proxy_pass http://api:3100/health/;
    }

    location /api/v1/admin/imports {
        client_max_body_size 25m;
        limit_req zone=api_general burst=20 nodelay;
        proxy_pass http://api:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/auth/ {
        limit_req zone=api_auth burst=5 nodelay;
        proxy_pass http://api:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=api_general burst=20 nodelay;
        client_max_body_size 1m;
        proxy_pass http://api:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }
}
