# Installed over s3.conf by scripts/enable-tls.sh once a certificate
# exists. Edit this file, not s3.conf, for TLS-time changes.

server {
    listen 80;
    listen [::]:80;
    server_name s3-health-house.aljoodnet.info;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name s3-health-house.aljoodnet.info;

    ssl_certificate     /etc/letsencrypt/live/s3-health-house.aljoodnet.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3-health-house.aljoodnet.info/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    client_max_body_size 20m;

    location / {
        proxy_pass http://minio:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
