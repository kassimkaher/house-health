  nutrition_reviewer
  data_manager
  support_admin
  super_admin
}

enum AccountStatus {
  pending_verification
  active
  suspended
  deleted
}

enum AuthProvider {
  password
  google
}

enum AuthTokenKind {
  email_verify
  password_reset
}

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum GoalType {
  lose
  maintain
  gain
}

enum UnitPreference {
