{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "API_PORT",
    "APP_BASE_URL",
    "ADMIN_WEB_ORIGIN",
    "CORS_ORIGINS",
    "JWT_PRIVATE_KEY_PEM",
    "JWT_PUBLIC_KEY_PEM",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REDIRECT_URI",
    "SEED_DEV_ACCOUNTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "openapi": {
      "dependsOn": ["^build"],
      "outputs": ["../../docs/openapi.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
